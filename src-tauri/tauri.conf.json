{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ototune",
  "version": "0.1.0",
  "identifier": "com.Ototune.org",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "decorations": false,
        "title": "Ototune",
        "width": 1024,
        "height": 700,
        "visible": false,
        "minWidth": 700,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/ototune.icns",
      "icons/ototune.ico"
    ],
    "externalBin": ["binaries/yt-dlp"]
  }
}
